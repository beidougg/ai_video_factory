      "orientation": "landscape",
      "dimensions": {
        "width": 1920,
        "height": 1080
      },
      "fps": 30,
      "defaultDuration": 60,
      "features": ["clean_layout", "product_focus", "text_overlay"],
      "recommendedPlatforms": ["youtube", "bilibili"],
      "tags": ["product", "ecommerce", "showcase"]
    }
