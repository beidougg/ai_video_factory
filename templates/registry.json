      "tags": ["knowledge", "education", "animation"]
    },
    {
      "id": "animation_knowledge_portrait",
      "name": "动画科普模板（竖屏）",
      "description": "动画科普风格的竖屏 9:16 版本，适用于抖音/快手/小红书等平台",
      "entry": "templates/animation_knowledge_portrait/src/index.tsx",
      "compositionId": "AnimationKnowledgePortrait",
      "orientation": "portrait",
      "dimensions": {
        "width": 1080,
        "height": 1920
      },
      "fps": 30,
      "defaultDuration": 90,
      "features": ["gradient_background", "particle_effects", "scene_animations", "title_card", "mobile_optimized"],
      "recommendedPlatforms": ["douyin", "kuaishou", "xiaohongshu"],
      "tags": ["knowledge", "education", "animation", "portrait", "9:16"]
    },
    {
      "id": "product_showcase",
      "name": "产品展示模板（横屏）",
