# AI Video Factory 环境配置
# 复制此文件为 .env 并填入你的密钥

# ============ DeepSeek API ============
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 可选：自定义 API 地址
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 可选：自定义模型
# DEEPSEEK_MODEL=deepseek-chat

# ============ YouTube OAuth ============
# 获取地址：https://console.cloud.google.com/apis/credentials
# 需要创建 OAuth 2.0 Client ID (Web application type)
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here

# 可选：自定义回调地址和端口
# YOUTUBE_REDIRECT_URI=http://localhost:3000/callback
# YOUTUBE_REDIRECT_PORT=3000

# ============ 飞书 (可选) ============
# FEISHU_APP_ID=cli_xxxxx

# ============ 代理 (国内访问 Google/GitHub 需要) ============
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
