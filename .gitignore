# 环境变量 (含 API Key)
.env

# YouTube OAuth Token
.youtube_token.json

# 依赖
node_modules/

# n8n 数据库
~/.n8n/

# 输出文件
outputs/*.mp4
outputs/*.mp3
outputs/*.vtt
outputs/pipe_*/

# 渲染临时产物（模板 public 下的配音）
templates/*/public/_voice.mp3

# 脚本生成结果
scripts/pipe_*.json

# 工作流备份
workflows/backup_*.js
workflows/backup_*.txt
